  if(!trabajadores || trabajadores.length === 0){
    listaTrabajandoDiv.innerHTML = "<div>No hay trabajadores en esta obra</div>";
    modalTrabajando.classList.remove("oculto");
    return;
  }

  trabajadores.forEach(trabajador => {
    const fichajesTrabajador = (fichajesHoy || []).filter(f => f.trabajador === trabajador.nombre);

    let estado = "NO FICHO ENTRADA";

    if(fichajesTrabajador.length > 0){
      const fichajeConSalida = fichajesTrabajador.find(f => f.entrada && f.salida);
      const fichajeTrabajando = fichajesTrabajador.find(f => f.entrada && !f.salida);

      if(fichajeTrabajando){
        estado = "TRABAJANDO";
      } else if(fichajeConSalida){
        const horasTexto = calcularHorasRedondeadasDesdeFichaje(fichajeConSalida);
        estado = "SALIO, " + horasTexto + " H";
      } else {
        estado = "FICHAJE INCOMPLETO";
      }
    }

    const boton = document.createElement("button");
    boton.className = "botonTrabajador";
    boton.textContent = trabajador.nombre + " — " + estado;

    boton.addEventListener("click", () => {
      abrirFichaTrabajador(trabajador);
    });

    listaTrabajandoDiv.appendChild(boton);
  });

