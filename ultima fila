async function entrarApp(){
  let pin = "";

  inputs.forEach(input => {
    pin += input.value;
  });

  if(pin.length !== 4){
    mensajeLogin.textContent = "Introduce el PIN completo";
    return;
  }

  if(pin === PIN_ENCARGADO){
    mensajeLogin.textContent = "";
    pantallaLogin.classList.add("oculto");
    pantallaEncargado.classList.remove("oculto");
    await cargarObras();
    return;
  }

  const { data, error } = await supabaseClient
    .from("trabajadores")
    .select("*")
    .eq("pin", pin)
    .maybeSingle();

  if(error){
    console.log(error);
    mensajeLogin.textContent = "Error conectando";
    return;
  }

  if(!data){
    mensajeLogin.textContent = "PIN incorrecto";
    return;
  }

  trabajadorActual = data;
  nombreTrabajadorActual = data.nombre || "TRABAJADOR";
  obraTrabajadorActual = await cargarObraDeTrabajador(data.obra);

  mensajeLogin.textContent = "";
  mensajeTrabajador.textContent = "";
  pantallaLogin.classList.add("oculto");
  pantallaTrabajador.classList.remove("oculto");

  actualizarPantallaTrabajador();
}

async function ficharEntrada(){
  mensajeTrabajador.textContent = "";

  if(!trabajadorActual){
    mensajeTrabajador.textContent = "No se encontró el trabajador";
    return;
  }

  if(!obraTrabajadorActual){
    mensajeTrabajador.textContent = "No se encontró la obra del trabajador";
    return;
  }

  if(
    obraTrabajadorActual.latitud == null ||
    obraTrabajadorActual.longitud == null ||
    obraTrabajadorActual.radio_fichaje == null
  ){
    mensajeTrabajador.textContent = "La obra no tiene ubicación o radio configurado";
    return;
  }

  try{
    mensajeTrabajador.textContent = "Comprobando ubicación...";

    const ubicacion = await obtenerUbicacionActual();

    const distancia = calcularDistanciaMetros(
      ubicacion.latitud,
      ubicacion.longitud,
      parseFloat(obraTrabajadorActual.latitud),
      parseFloat(obraTrabajadorActual.longitud)
    );

    const radioPermitido = parseFloat(obraTrabajadorActual.radio_fichaje);

    if(distancia > radioPermitido){
      mensajeTrabajador.textContent = "Fuera del radio permitido de la obra";
      return;
    }

    guardarEstadoDia("trabajando");
    actualizarPantallaTrabajador();
    mensajeTrabajador.textContent = "Fichaje correcto";

  }catch(error){
    console.log(error);
    mensajeTrabajador.textContent = "No se pudo comprobar la ubicación";
  }
}

