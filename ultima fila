async function modificarHorasSemana(){
  if(!trabajadorSeleccionadoFicha || datosSemanaActual.length === 0){
    return;
  }

  const diaTextoOriginal = prompt(
    "Escribe el día a modificar.\n\nEjemplo:\nMIERCOLES\n\nDías válidos:\nLUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO"
  );

  if(!diaTextoOriginal) return;

  const diaTexto = diaTextoOriginal.trim().toUpperCase()
    .replace("MIÉRCOLES", "MIERCOLES")
    .replace("SÁBADO", "SABADO");

  const mapaDias = {
    "LUNES": "LUNES",
    "MARTES": "MARTES",
    "MIERCOLES": "MIÉRCOLES",
    "JUEVES": "JUEVES",
    "VIERNES": "VIERNES",
    "SABADO": "SÁBADO",
    "DOMINGO": "DOMINGO"
  };

  if(!mapaDias[diaTexto]){
    alert("Día no válido");
    return;
  }

  const horasTexto = prompt("Escribe las horas nuevas para " + mapaDias[diaTexto]);
  if(horasTexto === null || horasTexto === "") return;

  const nuevasHoras = parseFloat(horasTexto);
  if(isNaN(nuevasHoras) || nuevasHoras < 0){
    alert("Horas no válidas");
    return;
  }

  const nombreNormalizado = mapaDias[diaTexto];
  const dia = datosSemanaActual.find(d => d.nombreDia === nombreNormalizado);

  if(!dia){
    alert("No se encontró ese día en la semana");
    return;
  }

  const horasFinales = Math.round(nuevasHoras);

  try{
    await guardarCorreccionHoras(dia.fecha, horasFinales);
    dia.horas = horasFinales;
    renderHorasSemana(datosSemanaActual);
    alert("Horas guardadas correctamente");
  }catch(error){
    console.log(error);
    alert("Error al guardar las horas");
  }
}

async function modificarHorasMes(){
  if(!trabajadorSeleccionadoFicha || datosMesActual.length === 0){
