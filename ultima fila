async function cargarYRenderizarMes(){
  if(!trabajadorSeleccionadoFicha){
    return;
  }

  const primerDia = new Date(añoVisualizado, mesVisualizado, 1);
  const ultimoDia = new Date(añoVisualizado, mesVisualizado + 1, 0);

  const fechaInicio = formatearFechaYYYYMMDD(primerDia);
  const fechaFin = formatearFechaYYYYMMDD(ultimoDia);

  const { data, error } = await supabaseClient
    .from("fichajes")
    .select("*")
    .eq("trabajador", trabajadorSeleccionadoFicha.nombre)
    .eq("obra", trabajadorSeleccionadoFicha.obra)
    .gte("fecha", fechaInicio)
    .lte("fecha", fechaFin)
    .order("fecha", { ascending: true });

  if(error){
    console.log(error);
    alert("Error cargando horas del mes");
    return;
  }

  const horasPorDia = construirHorasPorFecha(data || []);
  const totalDias = diasEnMes(añoVisualizado, mesVisualizado);

  datosMesActual = [];

  for(let dia = 1; dia <= totalDias; dia++){
    const fecha = new Date(añoVisualizado, mesVisualizado, dia);
    const clave = formatearFechaYYYYMMDD(fecha);

    datosMesActual.push({
      dia: dia,
      fecha: clave,
      horas: horasPorDia[clave] || 0
    });
  }

  renderHorasMes();
}

