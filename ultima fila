function obtenerUbicacionActual(){
  return new Promise((resolve, reject) => {
    if(!navigator.geolocation){
      reject(new Error("Tu dispositivo no permite geolocalización"));
      return;
    }

    navigator.geolocation.getCurrentPosition(
      posicion => {
        resolve({
          latitud: posicion.coords.latitude,
          longitud: posicion.coords.longitude
        });
      },
      error => {
        reject(error);
      },
      {
        enableHighAccuracy: true,
        timeout: 15000,
        maximumAge: 0
      }
    );
  });
}

function calcularDistanciaMetros(lat1, lon1, lat2, lon2){
  const R = 6371000;
  const toRad = grados => grados * Math.PI / 180;

  const dLat = toRad(lat2 - lat1);
  const dLon = toRad(lon2 - lon1);

  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
    Math.sin(dLon / 2) * Math.sin(dLon / 2);

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c;
}

function calcularHorasRedondeadasDesdeFichaje(fichaje){
  if(!fichaje){
    return 0;
  }

  if(fichaje.horas_redondeadas != null){
    return Number(fichaje.horas_redondeadas);
  }

  if(!fichaje.entrada || !fichaje.salida){
    return 0;
  }

  const entrada = new Date(fichaje.entrada);
  const salida = new Date(fichaje.salida);

  let horas = (salida - entrada) / 1000 / 60 / 60;

  const minutosSalida = salida.getHours() * 60 + salida.getMinutes();
  const limiteComida = 14 * 60 + 25;

  if(minutosSalida > limiteComida){
    horas = horas - 1;
  }

  if(horas < 0){
    horas = 0;
  }

  return Math.round(horas);
}

function construirHorasPorFecha(fichajes){
  const mapa = {};

  (fichajes || []).forEach(fichaje => {
    const fecha = fichaje.fecha;
    if(!fecha) return;

    const valor = calcularHorasRedondeadasDesdeFichaje(fichaje);
    const tieneCorreccion = fichaje.horas_redondeadas != null;

    if(!mapa[fecha]){
      mapa[fecha] = {
        horas: valor,
        corregido: tieneCorreccion
      };
      return;
    }

    if(tieneCorreccion){
      mapa[fecha] = {
        horas: valor,
        corregido: true
      };
      return;
    }

    if(!mapa[fecha].corregido){
      mapa[fecha].horas = valor;
    }
  });

  const salida = {};
  Object.keys(mapa).forEach(fecha => {
    salida[fecha] = mapa[fecha].horas;
  });

  return salida;
}

function obtenerInicioSemana(fecha){
  const d = new Date(fecha);
  const dia = d.getDay();
  const ajuste = dia === 0 ? -6 : 1 - dia;
  d.setDate(d.getDate() + ajuste);
  d.setHours(0,0,0,0);
  return d;
}

function formatearFechaYYYYMMDD(fecha){
  const año = fecha.getFullYear();
  const mes = String(fecha.getMonth() + 1).padStart(2, "0");
  const dia = String(fecha.getDate()).padStart(2, "0");
  return `${año}-${mes}-${dia}`;
}

