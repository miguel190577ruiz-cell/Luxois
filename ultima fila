    .order("nombre", { ascending: true });

  if(errorTrabajadores){
    console.log(errorTrabajadores);
    alert("Error cargando trabajadores");
    return;
  }

  const { data: fichajesHoy, error: errorFichajes } = await supabaseClient
    .from("fichajes")
    .select("*")
    .eq("obra", obraSeleccionada)
    .eq("fecha", hoy);

  if(errorFichajes){
    console.log(errorFichajes);
    alert("Error cargando fichajes");
    return;
