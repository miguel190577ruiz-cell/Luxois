async function guardarCorreccionHoras(fecha, horasRedondeadas){
  if(!trabajadorSeleccionadoFicha){
    throw new Error("No hay trabajador seleccionado");
  }

  const { data: existentes, error: errorBuscar } = await supabaseClient
    .from("fichajes")
    .select("id")
    .eq("trabajador", trabajadorSeleccionadoFicha.nombre)
    .eq("obra", trabajadorSeleccionadoFicha.obra)
    .eq("fecha", fecha);

  if(errorBuscar){
    throw errorBuscar;
  }

  if(existentes && existentes.length > 0){
    const { error: errorUpdate } = await supabaseClient
      .from("fichajes")
      .update({
        horas_redondeadas: horasRedondeadas,
        horas: horasRedondeadas
      })
      .eq("trabajador", trabajadorSeleccionadoFicha.nombre)
      .eq("obra", trabajadorSeleccionadoFicha.obra)
      .eq("fecha", fecha);

    if(errorUpdate){
      throw errorUpdate;
    }
  } else {
    const { error: errorInsert } = await supabaseClient
      .from("fichajes")
      .insert([{
        trabajador: trabajadorSeleccionadoFicha.nombre,
        obra: trabajadorSeleccionadoFicha.obra,
        fecha: fecha,
        horas: horasRedondeadas,
        horas_redondeadas: horasRedondeadas
      }]);

    if(errorInsert){
      throw errorInsert;
    }
  }
}

