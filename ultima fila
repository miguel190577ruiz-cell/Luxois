btnCerrarModalObras.addEventListener("click", cerrarModalObras);
btnCerrarModalTrabajando.addEventListener("click", cerrarModalTrabajando);

btnFichaHorasSemana.addEventListener("click", abrirHorasSemanaTrabajador);
btnFichaHorasMes.addEventListener("click", abrirHorasMesTrabajador);

btnCerrarFichaTrabajador.addEventListener("click", cerrarFichaTrabajador);

btnCerrarHorasSemana.addEventListener("click", cerrarHorasSemana);
btnModificarSemana.addEventListener("click", modificarHorasSemana);
btnImprimirObraSemana.addEventListener("click", imprimirObraSemana);
btnImprimirGestoriaSemana.addEventListener("click", imprimirGestoriaSemana);

btnCerrarHorasMes.addEventListener("click", cerrarHorasMes);
btnModificarMes.addEventListener("click", modificarHorasMes);
btnImprimirObraMes.addEventListener("click", imprimirObraMes);
btnImprimirGestoriaMes.addEventListener("click", imprimirGestoriaMes);

btnMesAnterior.addEventListener("click", async () => {
  if(mesVisualizado === 0){
    mesVisualizado = 11;
    añoVisualizado--;
  } else {
    mesVisualizado--;
  }
  await cargarYRenderizarMes();
});

btnMesSiguiente.addEventListener("click", async () => {
  if(mesVisualizado === 11){
    mesVisualizado = 0;
    añoVisualizado++;
  } else {
    mesVisualizado++;
  }
  await cargarYRenderizarMes();
});

});
</script>

